(*
  PRG_MQTT — MQTT telemetry publisher and RPC subscriber
  Paste this into the IMPLEMENTATION (lower) section of PRG_MQTT in CODESYS.
  Call PRG_MQTT from MainTask (same task as PLC_PRG).

  ThingsBoard device: PLC_Gateway
  Access token:       5FT2jeSK3hla6ZWBnrQU
*)

// ── Publisher configuration ───────────────────────────────────────────────
GVL_MQTT.fbMQTT_Pub.i_xEnable        := TRUE;
GVL_MQTT.fbMQTT_Pub.i_sBrokerAddress := 'thingsboard.cloud';
GVL_MQTT.fbMQTT_Pub.i_uiPort         := 1883;
GVL_MQTT.fbMQTT_Pub.i_sUsername      := '5FT2jeSK3hla6ZWBnrQU';
GVL_MQTT.fbMQTT_Pub.i_sPassword      := '';
GVL_MQTT.fbMQTT_Pub.i_sClientID      := 'codesys-plc-pub';
GVL_MQTT.fbMQTT_Pub.i_sTopicPublish  := 'v1/devices/me/telemetry';
GVL_MQTT.fbMQTT_Pub.i_xRetain        := FALSE;
GVL_MQTT.fbMQTT_Pub.i_xAutoReconnect := TRUE;

// ── Subscriber configuration ──────────────────────────────────────────────
GVL_MQTT.fbMQTT_Sub.i_xEnable         := TRUE;
GVL_MQTT.fbMQTT_Sub.i_sBrokerAddress  := 'thingsboard.cloud';
GVL_MQTT.fbMQTT_Sub.i_uiPort          := 1883;
GVL_MQTT.fbMQTT_Sub.i_sUsername       := '5FT2jeSK3hla6ZWBnrQU';
GVL_MQTT.fbMQTT_Sub.i_sPassword       := '';
GVL_MQTT.fbMQTT_Sub.i_sClientID       := 'codesys-plc-sub';
GVL_MQTT.fbMQTT_Sub.i_sTopicSubscribe := 'v1/devices/me/rpc/request/+';
GVL_MQTT.fbMQTT_Sub.i_xSubscribe      := TRUE;
GVL_MQTT.fbMQTT_Sub.i_xAutoReconnect  := TRUE;

// ── Publish telemetry every 2 seconds ────────────────────────────────────
GVL_MQTT.tPublishTimer(IN := TRUE, PT := T#2S);

IF GVL_MQTT.tPublishTimer.Q THEN
    GVL_MQTT.tPublishTimer(IN := FALSE);

    // Group 1: Input line signals
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'create_piece_I1',   i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Create_Piece_I1));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'create_piece_I2',   i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Create_Piece_I2));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'create_piece_I3',   i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Create_Piece_I3));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'create_piece_I4',   i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Create_Piece_I4));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'piece_material_I1', i_sValueToAdd := WORD_TO_STRING(PLC_PRG.piece_material_I1));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'piece_material_I2', i_sValueToAdd := WORD_TO_STRING(PLC_PRG.piece_material_I2));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'piece_material_I3', i_sValueToAdd := WORD_TO_STRING(PLC_PRG.piece_material_I3));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'piece_material_I4', i_sValueToAdd := WORD_TO_STRING(PLC_PRG.piece_material_I4));
    GVL_MQTT.fbMQTT_Pub.i_sPayload := MQTT_Client.FC_CreateJSON();
    GVL_MQTT.fbMQTT_Pub.i_xPublish := TRUE;
    GVL_MQTT.fbMQTT_Pub();
    GVL_MQTT.fbMQTT_Pub.i_xPublish := FALSE;

    // Group 2: Unload request signals
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_req_U1',  i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Unload_Req_U1));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_req_U2',  i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Unload_Req_U2));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_req_U3',  i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Unload_Req_U3));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_req_U4',  i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Unload_Req_U4));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_req_U5',  i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Unload_Req_U5));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_req_U6',  i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Unload_Req_U6));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_req_U7',  i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Unload_Req_U7));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_req_U8',  i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Unload_Req_U8));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_req_U9',  i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Unload_Req_U9));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_req_U10', i_sValueToAdd := BOOL_TO_STRING(PLC_PRG.Unload_Req_U10));
    GVL_MQTT.fbMQTT_Pub.i_sPayload := MQTT_Client.FC_CreateJSON();
    GVL_MQTT.fbMQTT_Pub.i_xPublish := TRUE;
    GVL_MQTT.fbMQTT_Pub();
    GVL_MQTT.fbMQTT_Pub.i_xPublish := FALSE;

    // Group 3: Unload material type per dock
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_type_U1',  i_sValueToAdd := WORD_TO_STRING(PLC_PRG.Unload_Type_U1));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_type_U2',  i_sValueToAdd := WORD_TO_STRING(PLC_PRG.Unload_Type_U2));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_type_U3',  i_sValueToAdd := WORD_TO_STRING(PLC_PRG.Unload_Type_U3));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_type_U4',  i_sValueToAdd := WORD_TO_STRING(PLC_PRG.Unload_Type_U4));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_type_U5',  i_sValueToAdd := WORD_TO_STRING(PLC_PRG.Unload_Type_U5));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_type_U6',  i_sValueToAdd := WORD_TO_STRING(PLC_PRG.Unload_Type_U6));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_type_U7',  i_sValueToAdd := WORD_TO_STRING(PLC_PRG.Unload_Type_U7));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_type_U8',  i_sValueToAdd := WORD_TO_STRING(PLC_PRG.Unload_Type_U8));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_type_U9',  i_sValueToAdd := WORD_TO_STRING(PLC_PRG.Unload_Type_U9));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'unload_type_U10', i_sValueToAdd := WORD_TO_STRING(PLC_PRG.Unload_Type_U10));
    GVL_MQTT.fbMQTT_Pub.i_sPayload := MQTT_Client.FC_CreateJSON();
    GVL_MQTT.fbMQTT_Pub.i_xPublish := TRUE;
    GVL_MQTT.fbMQTT_Pub();
    GVL_MQTT.fbMQTT_Pub.i_xPublish := FALSE;

    // Group 4: Warehouse counts
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'W1_count', i_sValueToAdd := WORD_TO_STRING(GVL.W1_Count));
    MQTT_Client.FC_AddKeyValueToJSON(i_sKeyToAdd := 'W2_count', i_sValueToAdd := WORD_TO_STRING(GVL.W2_Count));
    GVL_MQTT.fbMQTT_Pub.i_sPayload := MQTT_Client.FC_CreateJSON();
    GVL_MQTT.fbMQTT_Pub.i_xPublish := TRUE;
    GVL_MQTT.fbMQTT_Pub();
    GVL_MQTT.fbMQTT_Pub.i_xPublish := FALSE;

END_IF

// ── Call subscriber FB every scan ─────────────────────────────────────────
GVL_MQTT.fbMQTT_Sub();

// ── Handle incoming RPC commands from ThingsBoard ─────────────────────────
IF GVL_MQTT.fbMQTT_Sub.q_xReceivedMessageNotification THEN
    GVL_MQTT.sRPCMessage := GVL_MQTT.fbMQTT_Sub.q_sLastReceivedMessage;
    GVL_MQTT.bNewRPC     := TRUE;
END_IF
